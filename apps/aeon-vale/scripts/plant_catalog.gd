static func valid(species: int) -> bool:
	return species > 0 and species <= MAX_ID and species not in [13,14]

static func is_tree(species: int) -> bool:
	# Preserve the cactus life/dead-stem behavior from version 2 saves.
	return species == 10 or TREES.has(species)

static func leaf_color(species: int) -> Color:
	return Color(LEAF_COLORS[clampi(species - 1, 0, MAX_ID - 1)])

static func is_shrub(species: int) -> bool:
	return species in [16,19,20,40,45,49,52]

static func is_canopy(species: int) -> bool:
	# Fertilizer use is distinct from lifespan and the saved botanical tree category.
	return is_tree(species) or species==54

static func is_ground_cover(species: int) -> bool:
	return species in [8,15,17,18,35,36,37,38,39,41,42,43,44,46,47,48,50,66,67,70]
