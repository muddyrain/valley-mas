[resource]
script = ExtResource("1")
id = "SUR_011"
name = "贺临川"
age = 0
occupation = "户外领队 / 应急志愿者"
role = "团队保护"
personality = "稳重、负责，持续关注路线、天气和每个人的状态。"
background = "他习惯照看一个完整团队，判断什么时候继续走，什么时候应该停下来。"
